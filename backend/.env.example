# This file mirrors the root .env.example — the authoritative reference is:
# /MatchMyRoom/.env.example
#
# Copy the root file to the project root: cp .env.example .env

# ─── Database ───
DATABASE_URL=postgresql://user:password@localhost:5432/matchmyroom

# ─── Auth (Supabase) ───
# Your Supabase project URL. The backend derives the JWKS endpoint from this
# to verify Supabase-issued JWTs — do not hardcode the JWKS URL elsewhere.
SUPABASE_URL=https://your-project-ref.supabase.co

# ─── CORS ───
ALLOWED_ORIGINS=https://yourdomain.com

# ─── Frontend URL (used in password reset emails) ───
FRONTEND_URL=https://yourdomain.com

# ─── Cloudinary (profile photos) ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email / Resend ───
RESEND_API_KEY=

# ─── Email / SMTP fallback ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
