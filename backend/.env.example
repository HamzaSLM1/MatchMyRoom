DATABASE_URL=sqlite:///./matchmyroom.db
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudinary Configuration (Get these from cloudinary.com after signing up)
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# Email Configuration (For sending match notifications)
# For Gmail: Use "smtp.gmail.com" and enable "App Passwords" in Google Account settings
# For other providers: Update SMTP_HOST and SMTP_PORT accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=noreply@matchmyroom.com
APP_URL=http://localhost:3000
